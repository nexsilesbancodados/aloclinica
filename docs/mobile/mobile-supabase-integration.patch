+/**
+ * Configuração do backend (Supabase da AloClínica).
+ *
+ * Ordem de resolução: variável EXPO_PUBLIC_* → app.json `extra` → default público.
+ * A anon key do Supabase é pública por design (segura no cliente) — o que protege
+ * os dados é o RLS no banco, não o segredo da chave.
+ *
+ * Para produção, defina EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY
+ * (via .env com react-native-dotenv ou EAS secrets).
+ */
+import Constants from "expo-constants";
+
+const extra = (Constants.expoConfig?.extra ?? {}) as Record<string, string | undefined>;
+
+const DEFAULT_SUPABASE_URL = "https://pwxvvimdtmvziynbspgx.supabase.co";
