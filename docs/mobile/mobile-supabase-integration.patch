+/**
+ * AuthContext — autenticação real contra o Supabase da AloClínica.
+ *
+ * Substitui o login mock. Expõe sessão, perfil, papéis (roles) e ações.
+ * O roteamento por papel (paciente vs médico) usa `primaryRole`.
+ */
+import React, { createContext, useContext, useEffect, useMemo, useState } from "react";
+import type { Session, User } from "@supabase/supabase-js";
+import { supabase } from "@/src/lib/supabase";
+
+export type AppRole = "patient" | "doctor" | "admin" | "support" | "clinic" | "ophthalmologist" | string;
+
+type Profile = {
+  user_id: string;
+  first_name: string | null;
+  last_name: string | null;
+  cpf: string | null;
+  phone: string | null;
+  avatar_url?: string | null;
+} | null;
+
+interface AuthState {
+  session: Session | null;
+  user: User | null;
+  profile: Profile;
+  roles: AppRole[];
+  primaryRole: AppRole | null;
+  loading: boolean;
+  signIn: (email: string, password: string) => Promise<{ error: string | null }>;
+  signUp: (
+    email: string,
+    password: string,
+    meta: { first_name?: string; last_name?: string; cpf?: string; phone?: string; role?: AppRole },
+  ) => Promise<{ error: string | null }>;
+  signOut: () => Promise<void>;
+  refresh: () => Promise<void>;
+}
+
+const AuthContext = createContext<AuthState | undefined>(undefined);
+
+async function loadRolesAndProfile(userId: string): Promise<{ roles: AppRole[]; profile: Profile }> {
+  const [rolesRes, profileRes] = await Promise.all([
+    supabase.from("user_roles").select("role").eq("user_id", userId),
+    supabase.from("profiles").select("user_id, first_name, last_name, cpf, phone").eq("user_id", userId).maybeSingle(),
+  ]);
+  const roles = (rolesRes.data ?? []).map((r: { role: AppRole }) => r.role);
+  return { roles, profile: (profileRes.data as Profile) ?? null };
+}
+
+// Prioridade para decidir a home inicial quando o usuário tem múltiplos papéis.
+function pickPrimaryRole(roles: AppRole[]): AppRole | null {
+  const order: AppRole[] = ["admin", "doctor", "ophthalmologist", "clinic", "support", "patient"];
+  for (const r of order) if (roles.includes(r)) return r;
+  return roles[0] ?? null;
+}
+
+export function AuthProvider({ children }: { children: React.ReactNode }) {
+  const [session, setSession] = useState<Session | null>(null);
+  const [profile, setProfile] = useState<Profile>(null);
+  const [roles, setRoles] = useState<AppRole[]>([]);
+  const [loading, setLoading] = useState(true);
+
+  const hydrate = async (s: Session | null) => {
+    setSession(s);
+    if (s?.user) {
+      try {
+        const { roles, profile } = await loadRolesAndProfile(s.user.id);
+        setRoles(roles);
+        setProfile(profile);
+      } catch {
+        setRoles([]);
+        setProfile(null);
+      }
+    } else {
+      setRoles([]);
+      setProfile(null);
+    }
+  };
+
+  useEffect(() => {
+    let mounted = true;
+    supabase.auth.getSession().then(async ({ data }) => {
+      if (!mounted) return;
+      await hydrate(data.session);
+      setLoading(false);
+    });
+    const { data: sub } = supabase.auth.onAuthStateChange(async (_event, s) => {
+      await hydrate(s);
+    });
+    return () => {
+      mounted = false;
+      sub.subscription.unsubscribe();
+    };
+  }, []);
+
+  const signIn = async (email: string, password: string) => {
+    const { error } = await supabase.auth.signInWithPassword({ email: email.trim(), password });
+    return { error: error?.message ?? null };
+  };
+
+  const signUp: AuthState["signUp"] = async (email, password, meta) => {
+    const { error } = await supabase.auth.signUp({
+      email: email.trim(),
+      password,
+      options: {
+        // SECURITY: nunca envie role=admin/support daqui — o backend ignora esses
+        // valores no signup (ver migração de hardening). Papel padrão = patient.
+        data: {
+          first_name: meta.first_name,
+          last_name: meta.last_name,
+          cpf: meta.cpf,
+          phone: meta.phone,
+          role: meta.role === "doctor" ? "doctor" : "patient",
+        },
+      },
+    });
+    return { error: error?.message ?? null };
+  };
+
+  const signOut = async () => {
+    await supabase.auth.signOut();
+  };
+
+  const refresh = async () => {
+    const { data } = await supabase.auth.getSession();
+    await hydrate(data.session);
+  };
+
+  const value = useMemo<AuthState>(
+    () => ({
+      session,
+      user: session?.user ?? null,
+      profile,
+      roles,
+      primaryRole: pickPrimaryRole(roles),
+      loading,
+      signIn,
+      signUp,
+      signOut,
+      refresh,
+    }),
+    [session, profile, roles, loading],
+  );
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth(): AuthState {
+  const ctx = useContext(AuthContext);
+  if (!ctx) throw new Error("useAuth deve ser usado dentro de <AuthProvider>");
+  return ctx;
+}
