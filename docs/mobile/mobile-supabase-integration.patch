+/**
+ * Camada de dados — consultas (appointments).
+ *
+ * Padrão de referência para conectar as demais telas ao Supabase.
+ * O RLS garante que cada usuário só enxerga as próprias consultas, então
+ * as queries abaixo não precisam filtrar por segurança — mas filtramos por
+ * clareza e performance.
+ */
+import { supabase } from "@/src/lib/supabase";
+
+export interface AppointmentRow {
+  id: string;
+  patient_id: string;
+  doctor_id: string;
+  status: string;
+  scheduled_at: string;
+  price_at_booking: number | null;
+  payment_status: string | null;
+}
+
+/** Consultas do paciente logado (futuras primeiro). */
+export async function getPatientAppointments(patientId: string): Promise<AppointmentRow[]> {
+  const { data, error } = await supabase
+    .from("appointments")
+    .select("id, patient_id, doctor_id, status, scheduled_at, price_at_booking, payment_status")
+    .eq("patient_id", patientId)
+    .order("scheduled_at", { ascending: true });
+  if (error) throw error;
+  return (data as AppointmentRow[]) ?? [];
+}
+
+/** Agenda do médico logado. `doctorProfileId` = doctor_profiles.id. */
+export async function getDoctorAppointments(doctorProfileId: string): Promise<AppointmentRow[]> {
+  const { data, error } = await supabase
+    .from("appointments")
+    .select("id, patient_id, doctor_id, status, scheduled_at, price_at_booking, payment_status")
+    .eq("doctor_id", doctorProfileId)
+    .order("scheduled_at", { ascending: true });
+  if (error) throw error;
+  return (data as AppointmentRow[]) ?? [];
+}
