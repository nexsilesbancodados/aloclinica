# ============================================================================
# AloClínica — Variáveis de ambiente para PRODUÇÃO
# ============================================================================
#
# Este arquivo lista TODAS as variáveis necessárias para um deploy completo.
# Divide-se em três grupos:
#
#   1. FRONT (VITE_*)   → embutidas no bundle, expostas ao browser
#   2. SUPABASE EDGE    → secrets das edge functions (nunca expor)
#   3. EXTERNOS         → APIs de terceiros (Mercado Pago, VIDaaS, etc.)
#
# Antes de cada deploy:
#   - Copie pra .env.production e preencha
#   - Configure os secrets do Supabase via dashboard ou `supabase secrets set`
#   - Confira o checklist em `docs/PRE_DEPLOY_CHECKLIST.md`
#
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# 1. FRONT (VITE_*) — visíveis no bundle do navegador
# ────────────────────────────────────────────────────────────────────────────

# Supabase — projeto produção
VITE_SUPABASE_URL=https://pwxvvimdtmvziynbspgx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...  # anon key, NÃO o service_role

# URL pública canônica (usada em SEO, redirects, emails)
VITE_APP_URL=https://aloclinica.com.br

# Mercado Pago — chave PÚBLICA (front faz tokenization de cartão)
# Painel: https://www.mercadopago.com.br/developers/panel/credentials
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-...

# Sentry — captura de erros do front. Deixe vazio em dev/preview pra silenciar.
VITE_SENTRY_DSN=https://...@sentry.io/...

# Analytics — Google Analytics 4 + Meta Pixel (opcional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=1234567890

# Feature toggles em build time (sobrescrevem defaults de featureFlags.ts)
# VITE_FEATURE_ICP_BRASIL_SIGNATURE=true   # ativa fluxo VIDaaS
# VITE_FEATURE_CARTAO_PINGO=true           # ativa assinatura PingoCard
# VITE_ICP_ENABLED=true                    # legacy alias
# VITE_MEMED_ENABLED=true                  # ativa integração Memed no front

# ────────────────────────────────────────────────────────────────────────────
# 2. SUPABASE EDGE FUNCTIONS — secrets (NUNCA commitar valores reais)
# ────────────────────────────────────────────────────────────────────────────
# Configure via dashboard Supabase > Edge Functions > Secrets, ou:
#   supabase secrets set --env-file .env.production.edge

# Supabase core (auto-providos em edge, mas precisam estar setados pra local)
SUPABASE_URL=https://pwxvvimdtmvziynbspgx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mercado Pago — server-side
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=...  # HMAC SHA-256 secret do painel MP > Webhooks

# VIDaaS (ICP-Brasil) — necessário pra assinatura legal de receitas
# Sem isto, o front cai automaticamente em hash SHA-256 (assinatura simplificada)
VIDAAS_CLIENT_ID=...
VIDAAS_CLIENT_SECRET=...

# Memed — prescrição digital
MEMED_API_KEY=...
MEMED_SECRET_KEY=...

# CompreFace — KYC (face match)
COMPREFACE_URL=https://compreface.aloclinica.com.br
COMPREFACE_API_KEY=...
COMPREFACE_DETECT_KEY=...
COMPREFACE_VERIFY_KEY=...

# CFM — validação de CRM (BrasilAPI ou Consulta CRM)
CONSULTA_CRM_API_KEY=...

# DocuSeal — assinatura de documentos institucionais
DOCUSEAL_API_KEY=...

# WhatsApp via Evolution API
EVOLUTION_API_URL=https://evolution.aloclinica.com.br
EVOLUTION_API_KEY=...

# Email — Brevo (transacional) + Resend (fallback)
BREVO_API_KEY=...
RESEND_API_KEY=...
EMAIL_FROM=AloClínica <nao-responda@aloclinica.com.br>
EMAIL_FROM_NAME=AloClínica
EMAIL_FROM_ADDRESS=nao-responda@aloclinica.com.br
EMAIL_SUPPORT_ADDRESS=suporte@aloclinica.com.br
EMAIL_COMPANY_ADDRESS=Av. Paulista, 1000, São Paulo — SP

# Web Push (PWA notifications) — chave PRIVADA VAPID
# A pública vive hardcoded em src/components/notifications/PushNotificationToggle.tsx
VAPID_PRIVATE_KEY=...

# Anthropic Claude — assistente IA (PingoChat)
ANTHROPIC_API_KEY=sk-ant-...

# Metered — TURN/STUN servers para VideoConsultation (WebRTC)
METERED_APP_NAME=...
METERED_SECRET_KEY=...

# CoTURN próprio (alternativa ao Metered)
COTURN_HOST=turn.aloclinica.com.br
COTURN_PORT=3478
COTURN_USER=...
COTURN_PASS=...

# PACS — orthanc webhook secret pra exames de imagem (laudo)
PACS_WEBHOOK_SECRET=...

# Notificações administrativas (alertas críticos)
ADMIN_NOTIFY_EMAIL=admin@aloclinica.com.br

# URL canônica usada em emails e redirects (sem barra final)
APP_URL=https://aloclinica.com.br
SITE_URL=https://aloclinica.com.br
SITE_DOMAIN=aloclinica.com.br

# Sorteios PingoCard — configuração de tickets por plano (JSON)
# Ex: '{"basic":1,"premium":3,"vip":10}'
SWEEPSTAKE_TICKETS_BY_PLAN={"basic":1,"premium":3}
